doctype html 
html 
    head 
        title Login Page
    body
        div 
            .form-check
                input.form-check-input(type="radio" name="role" value="student") 
                label.form-check-label Student

        div 
            .form-check
                input.form-check-input(type="radio" name="role" value="staff") 
                label.form-check-label Staff

        form(action='/login' method='POST')
            .mb-3
                label(for='username') Username
                br
                input.form-control(type='text' name='username' placeholder= 'Username' required)
            br
            .mb-3
                label(for='password') Password
                br
                input.form-control(type='password' name='password' placeholder= 'Password' required)
            br
            button(type='Submit') Log In

            br
            p.form-toggle 
            p 
                a(href="/forgot") Forgot your password? 